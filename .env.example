# Copy to .env and fill in.
OPENAI_API_KEY=
LLM_FAST_MODEL=gpt-5-mini
LLM_SMART_MODEL=gpt-5

# SEC requires a descriptive User-Agent with contact email: https://www.sec.gov/os/accessing-edgar-data
SEC_USER_AGENT="FinSight research-demo your-email@example.com"

DATABASE_URL=postgresql+asyncpg://finsight:finsight@localhost:5432/finsight
REDIS_URL=redis://localhost:6379/0

EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# Agents call the FinSight MCP server in-process by default. To go over streamable HTTP,
# run `uv run python -m app.mcp.server --http` and set:
# MCP_URL=http://127.0.0.1:8001/mcp
RESEARCH_BUDGET_USD=0.10
